# Copy to .env and fill in. Docker Compose reads it automatically; for the
# binary, export the variables (set -a; . ./.env; set +a).

# RouterOS REST API (read-only user, see README "Router configuration")
MIKROTIK_URL=https://192.168.88.1
MIKROTIK_USER=tikscope
MIKROTIK_PASSWORD=change-me
MIKROTIK_INSECURE=true

# Line speed for the speedometers; leave empty to auto-scale to the peak
WAN_DOWN_MBPS=
WAN_UP_MBPS=

# Reachability probes from the collector
PROBE_ICMP=1.1.1.1,8.8.8.8
PROBE_DNS=192.168.88.1

# Retention
RETENTION=7d
METRICS_RETENTION=30d
EVENTS_RETENTION=30d

TZ=Europe/Zurich
